@INPROCEEDINGS{11238173,
  author={Bartak, Gerhard and Fiorelli, Riccardo and Meyer, Jan},
  booktitle={28th International Conference and Exhibition on Electricity Distribution (CIRED 2025)}, 
  title={Electromagnetic interference in the frequency range 2 kHz to 500 kHz - key findings of the 4th EMI study report prepared by CENELEC TC219/WG11}, 
  year={2025},
  volume={2025},
  number={},
  pages={3367-3371},
  abstract={The frequency range 2 kHz to 500 kHz becomes increasingly important in the study of electromagnetic interference (EMI) due to the growth of non-intentional emissions, e.g. from electric vehicle chargers, photovoltaic inverters, or converters for storage applications and heat pumps. Moreover, the frequency range is used by narrowband power line communication (PLC) applications in several bands from 9 kHz to 500 kHz. To support reliable and compatible operation of equipment and mains communication, CENELEC TC 219, responsible for European standardization on Mains Communicating Systems (MCS), regularly develops study reports with recent research results and findings related to frequencies between 2 kHz and 150 kHz and now up to 500 kHz. In continuation of three former study reports, CENELEC TC219 WG11 has now developed a fourth study report. This paper provides an overview of the report content, along with key findings and recommendations, with particular focus on standardization.},
  keywords={},
  doi={10.1049/icp.2025.2321},
  ISSN={},
