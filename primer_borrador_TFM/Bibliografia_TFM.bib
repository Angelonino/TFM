@INPROCEEDINGS{6351760,
  author={Gassara, Héla and Bali, Mohamed Chaker and Duval, Fabrice and Rouissi, Fatma and Ghazel, Adel},
  booktitle={2012 IEEE International Symposium on Electromagnetic Compatibility}, 
  title={Coupling interface circuit design for experimental characterization of the narrowband power line communication channel}, 
  year={2012},
  volume={},
  number={},
  pages={1-6},
  abstract={This paper presents the design of an appropriate coupling interface circuit for measuring indoor power line transmission channel characteristics in CENELEC/FCC/ARIB low-frequency bands. This coupling circuit prevents the powerful and damaging 50 Hz/220 V current from entering sensitive measurement equipments while allowing narrowband PLC signals reception. It also guarantees impedance matching and instruments protection from very large voltage spikes and fast transients. Tests following EN 50065-2-3 standard [1] are done to verify that the proposed coupling interface provides a high safety level and is in compliance with immunity requirements.},
  keywords={Coupling circuits;Frequency measurement;Couplings;Transient analysis;Power measurement;Attenuation;Narrowband},
  doi={10.1109/ISEMC.2012.6351760},
  ISSN={2158-1118},
  month={Aug},}

@INPROCEEDINGS{8254463,
  author={Hallak, George and Niess, Christoph and Bumiller, Gerd},
  booktitle={GLOBECOM 2017 - 2017 IEEE Global Communications Conference}, 
  title={Measurement Setup for Notch Evaluation of Narrowband PLC Devices}, 
  year={2017},
  volume={},
  number={},
  pages={1-6},
  abstract={The measurement and evaluation of the achievable notch depth by PLC devices in the narrowband frequencies is the topic of this paper. This is motivated by the interest of using the FCC above CENELEC band for smart grid applications where other systems and transmitters operate in an identical frequency range. A risk analysis of using the FCC band in Austria has shown that in some areas close to airports, interferences with non-directional beacons for aeronautical navigation cannot be excluded without notching [1]. We worked based on the ETSI TS 103 909 v1.1.1 standard when implementing the notch measurement test setup. The notch depth measurement has been applied to several PLC equipment from the same manufacturer or different manufacturers. This measurement setup has allowed the analysis of the reached notch depth by PLC devices within the FCC frequency band. We have found that the defined notch requirement by the current narrowband PLC standards with a minimum attenuation of 20 dB and 25 dB cannot be reached. Most tested and measured PLC devices can achieve a notch with a minimum of 13 dB attenuation and no device can achieve more than 17 dB. As a consequence, the proposed notch requirement by the narrowband PLC standards cannot be implemented on the existing equipment.},
  keywords={Voltage measurement;Attenuation;Frequency measurement;Standards;Narrowband;Oscilloscopes;Transfer functions},
  doi={10.1109/GLOCOM.2017.8254463},
  ISSN={},
  month={Dec},}